# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Server & Cloud Sync Configuration
# SUPABASE_URL: The REST/GraphQL API URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=""
# SUPABASE_ANON_KEY: The public anon API key for Supabase client interactions
SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY: Optional server-side service role key for admin sync operations
SUPABASE_SERVICE_ROLE_KEY=""

# Client-side Supabase keys (if connecting directly from browser in addition to server proxy)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

