{
  "id": "com.meridian.personalos",
  "name": "Meridian Personal OS",
  "short_name": "Meridian",
  "description": "Offline-First Material You Personal Systems Operating System with Google Drive and Cloud Backup",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#121411",
  "theme_color": "#121411",
  "orientation": "portrait-primary",
  "categories": [
    "productivity",
    "utilities",
    "lifestyle",
    "health"
  ],
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "note_taking": {
    "new_note_url": "/?route=journal&action=new"
  },
  "share_target": {
    "action": "/?route=journal",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/?route=overview&action=import",
      "name": "Meridian Backup JSON",
      "icons": [
        {
          "src": "/launchericon-192x192.png",
          "sizes": "192x192"
        }
      ],
      "accept": {
        "application/json": [".json"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+meridian",
      "url": "/?route=%s"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://meridianii.netlify.app"
    }
  ],
  "shortcuts": [
    {
      "name": "Daily Logbook",
      "short_name": "Journal",
      "description": "Open private daily logbook",
      "url": "/?route=journal",
      "icons": [{ "src": "/launchericon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Study Pomodoro",
      "short_name": "Study",
      "description": "Start a focused study session",
      "url": "/?route=study",
      "icons": [{ "src": "/launchericon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Recovery Tracker",
      "short_name": "Recovery",
      "description": "View streaks and urges",
      "url": "/?route=recovery",
      "icons": [{ "src": "/launchericon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Finance Ledger",
      "short_name": "Finance",
      "description": "Log income and expenses",
      "url": "/?route=finance",
      "icons": [{ "src": "/launchericon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "/launchericon-48x48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/launchericon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/launchericon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/launchericon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/launchericon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/launchericon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Meridian Personal OS Mobile Dashboard"
    },
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Meridian Personal OS Full Desktop Workspace"
    }
  ]
}
